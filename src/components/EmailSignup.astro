---
interface Props {
  heading?: string;
  description?: string;
  submitText?: string;
  source?: string;
}

const {
  heading = 'Get Free SEO Tips & Audit Insights',
  description = 'Weekly website optimisation tips straight to your inbox.',
  submitText = 'Subscribe',
  source = 'website',
} = Astro.props;
---

<form
  action="https://auditweb-drip-worker.sunnypat81.workers.dev/"
  method="post"
  class="max-w-md mx-auto"
  data-signup
>
  <input type="hidden" name="redirectTo" value="https://auditweb.site/subscribed/" />
  <input type="hidden" name="source" value={source} />
  <input type="text" name="honeypot" style="display:none" aria-label="Leave this field empty" tabindex="-1" autocomplete="off" />

  <div class="flex flex-col sm:flex-row gap-2">
    <input
      type="email"
      name="email"
      aria-label="Email address for weekly SEO tips"
      autocomplete="email"
      required
      placeholder="you@company.com"
      class="min-w-0 flex-1 px-4 py-2.5 bg-surface border border-border rounded-lg text-text placeholder:text-text-dim focus:outline-none focus:border-primary transition-colors text-sm"
    />
    <button
      type="submit"
      class="px-5 py-2.5 bg-primary hover:bg-primary-dark text-surface font-semibold text-sm rounded-lg transition-colors whitespace-nowrap"
    >
      {submitText}
    </button>
  </div>
  <div class="mt-3 flex justify-center" data-turnstile></div>
  <p class="text-xs text-text-muted mt-2 text-center" data-signup-msg role="status" hidden></p>
  <p class="text-xs text-text-dim mt-2 text-center">Free &bull; No spam &bull; Confirm by email &bull; Unsubscribe anytime</p>
</form>

<script>
  const SITEKEY = '0x4AAAAAAGK3li1BaMzjm8Hz';
  let apiLoading: Promise<void> | null = null;
  const loadApi = () =>
    (apiLoading ??= new Promise<void>((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('turnstile failed to load'));
      document.head.appendChild(s);
    }));

  document.querySelectorAll<HTMLFormElement>('form[data-signup]').forEach((form) => {
    const slot = form.querySelector<HTMLElement>('[data-turnstile]')!;
    const msg = form.querySelector<HTMLElement>('[data-signup-msg]')!;
    let rendered = false;
    const say = (text: string) => {
      msg.textContent = text;
      msg.hidden = !text;
    };
    const render = () => {
      if (rendered) return;
      rendered = true;
      loadApi()
        .then(() => {
          (window as any).turnstile.render(slot, {
            sitekey: SITEKEY,
            action: 'signup',
            theme: 'dark',
            callback: () => say(''),
          });
        })
        .catch(() => {
          rendered = false;
          say('The security check could not load. Please refresh and try again.');
        });
    };
    form.addEventListener('focusin', render);
    form.addEventListener('submit', (e) => {
      const token = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value;
      if (!token) {
        e.preventDefault();
        render();
        say('One quick check first. When it shows a tick, press the button again.');
      }
    });
  });
</script>
