---
---
<section class="html-checker" aria-labelledby="checker-heading">
  <h2 id="checker-heading">Check your page HTML</h2>
  <p>Paste page source to inspect eight on-page signals. The HTML stays in this tab and is not uploaded or saved.</p>
  <form id="html-audit-form">
    <label for="audit-page-url">Page URL <span>(used to resolve canonical links; never fetched)</span></label>
    <input id="audit-page-url" type="url" required placeholder="https://example.com/page/" autocomplete="off" />
    <label for="audit-html">Page HTML <span>(up to 1 MB)</span></label>
    <textarea id="audit-html" rows="10" required spellcheck="false" placeholder="Paste the HTML from View Page Source"></textarea>
    <p class="checker-help">Use public page source. Avoid pasting private account data or credentials. Do not treat a partial fragment as a full-page audit.</p>
    <div class="checker-actions">
      <button type="submit">Check HTML</button>
      <button type="button" id="audit-example" class="secondary">Load example</button>
      <button type="reset" class="secondary">Clear</button>
    </div>
  </form>
  <p id="audit-error" role="alert"></p>
  <p id="audit-status" role="status" aria-live="polite"></p>
  <div id="audit-results" hidden>
    <h3 tabindex="-1" id="audit-result-heading">HTML review findings</h3>
    <p>“Observed” means an element was found. Review its quality and purpose. These results do not measure site speed, SSL, crawlability or Google indexing.</p>
    <ol id="audit-checks"></ol>
    <button type="button" id="audit-download">Download findings (.md)</button>
    <p>Edit the findings in a text editor, or use the <a href="/resources/agency-audit-toolkit/">agency audit toolkit</a> to turn them into assigned actions.</p>
  </div>
  <noscript><p>This local checker needs JavaScript. You can still <a href="/website-audit-checklist/template/">download the printable manual checklist</a>.</p></noscript>
</section>

<script>
  import { auditHtml, reportMarkdown } from '../lib/html-audit.js';
  const form = document.querySelector<HTMLFormElement>('#html-audit-form')!;
  const url = document.querySelector<HTMLInputElement>('#audit-page-url')!;
  const html = document.querySelector<HTMLTextAreaElement>('#audit-html')!;
  const results = document.querySelector<HTMLElement>('#audit-results')!;
  const error = document.querySelector<HTMLElement>('#audit-error')!;
  const status = document.querySelector<HTMLElement>('#audit-status')!;
  const list = document.querySelector<HTMLOListElement>('#audit-checks')!;
  let report: ReturnType<typeof auditHtml> | null = null;
  function clearResults() { report = null; results.hidden = true; list.replaceChildren(); error.textContent = ''; status.textContent = ''; }
  form.addEventListener('input', clearResults);
  form.addEventListener('reset', clearResults);
  document.querySelector('#audit-example')!.addEventListener('click', () => {
    clearResults(); url.value = 'https://example.com/';
    html.value = '<!doctype html>\n<html lang="en"><head>\n<title>Example shop</title>\n<link rel="canonical" href="/">\n<meta name="robots" content="noindex">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n</head><body><h1>Example shop</h1><img src="/sample.jpg"></body></html>';
    status.textContent = 'Example loaded. It deliberately includes noindex and an image without alt text. Select Check HTML to inspect it.';
    html.focus();
  });
  form.addEventListener('submit', event => {
    event.preventDefault(); clearResults();
    try {
      report = auditHtml(html.value, url.value);
      for (const check of report.checks) {
        const item = document.createElement('li');
        const heading = document.createElement('h4'); heading.textContent = `${check.name} — ${check.status}`;
        const evidence = document.createElement('p'); evidence.textContent = check.evidence;
        const next = document.createElement('p'); next.textContent = check.nextStep;
        item.append(heading, evidence, next); list.append(item);
      }
      results.hidden = false; status.textContent = `${report.checks.length} checks reviewed. ${report.checks.filter(c => c.status === 'Review').length} need review.`;
      window.dispatchEvent(new Event('auditweb:html-check-complete'));
      document.querySelector<HTMLElement>('#audit-result-heading')!.focus();
    } catch (cause) { error.textContent = cause instanceof Error ? cause.message : 'Unable to read this HTML. Check the input and try again.'; }
  });
  document.querySelector('#audit-download')!.addEventListener('click', () => {
    if (!report) return;
    const file = URL.createObjectURL(new Blob([reportMarkdown(report)], { type: 'text/markdown;charset=utf-8' }));
    const a = document.createElement('a'); a.href = file; a.download = 'auditweb-html-findings.md'; a.click();
    setTimeout(() => URL.revokeObjectURL(file), 1000);
  });
</script>

<style>
  .html-checker { margin: 2rem 0; padding: clamp(1rem, 3vw, 2rem); border: 1px solid #64748b; background: #172338; }
  .html-checker h2 { margin-top: 0; }
  label { display: block; font-weight: 700; margin: 1rem 0 .5rem; }
  label span { display: block; font-size: .875rem; font-weight: 400; color: #cbd5e1; }
  input, textarea { width: 100%; min-width: 0; color: #f1f5f9; background: #0f172a; border: 1px solid #94a3b8; padding: .75rem; border-radius: .25rem; }
  textarea { font-family: ui-monospace, monospace; font-size: .875rem; resize: vertical; }
  .checker-help { font-size: .875rem; }
  .checker-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  button { background: #22d3ee; color: #0f172a; padding: .75rem 1rem; font-weight: 700; border-radius: .25rem; cursor: pointer; }
  button:hover { background: #67e8f9; }
  button:active { transform: translateY(1px); }
  button.secondary { background: transparent; border: 1px solid #94a3b8; color: #f1f5f9; }
  button.secondary:hover { background: #334155; }
  #audit-error { color: #fda4af; }
  #audit-checks { list-style: decimal; }
  #audit-checks :global(li) { padding: 1rem 0; border-bottom: 1px solid #64748b; overflow-wrap: anywhere; }
  #audit-checks :global(h4) { font-weight: 700; }
  #audit-checks :global(p) { margin: .5rem 0; }
</style>
