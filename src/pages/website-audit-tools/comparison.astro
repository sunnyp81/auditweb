import ContentLayout from '../../layouts/ContentLayout.astro';

const breadcrumbs = [
  { label: 'Website Audit', href: '/website-audit/' },
  { label: 'Tools', href: '/website-audit-tools/' },
  { label: 'Comparison', href: '/website-audit-tools/comparison/' },
];

const toc = [
  { label: 'Comparison Criteria', id: 'comparison-criteria' },
  { label: 'Feature Table', id: 'feature-table' },
  { label: 'Pricing Comparison', id: 'pricing-comparison' },
  { label: 'Best for Small Sites', id: 'best-for-small-sites' },
  { label: 'Best for Agencies', id: 'best-for-agencies' },
