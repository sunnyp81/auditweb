---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { auditTools, tasks } from '../../data/audit-tools';
import '../../styles/tool-directory.css';
const guides = [
  ['best-free', 'Free audit tools', 'Start an audit without a software subscription.'],
  ['comparison', 'Tool comparisons', 'Compare approaches before choosing your stack.'],
  ['best-software', 'Audit software', 'Explore larger-site and specialist platforms.'],
  ['automated', 'Automated audits', 'Plan recurring crawls and monitoring.'],
  ['white-label', 'White-label tools', 'Understand branded reporting options.'],
  ['agencies', 'Tools for agencies', 'Consider client access and multi-site workflows.'],
];
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Website audit tools', url: 'https://auditweb.site/website-audit-tools/',
  description: 'A directory of website audit tools with task filters, scope comparisons and specialist guides.',
  mainEntity: { '@type': 'ItemList', itemListOrder: 'https://schema.org/ItemListUnordered', numberOfItems: auditTools.length,
    itemListElement: auditTools.map((tool, i) => ({ '@type': 'ListItem', position: i + 1, name: tool.name, url: `https://auditweb.site/website-audit-tools/#tool-${tool.id}` })) },
};
---
<BaseLayout title="Website Audit Tools: Directory, Comparisons & Guides" description="Find website audit tools for SEO, crawling, speed and accessibility. Filter tools, compare their scope and explore free options, reviews and agency guides." canonical="https://auditweb.site/website-audit-tools/" schema={schema}>
  <script is:inline>document.documentElement.classList.add('tool-directory-js');</script>
  <Breadcrumbs items={[{ label: 'Website audit', href: '/website-audit/' }, { label: 'Audit tools', href: '/website-audit-tools/' }]} />
  <div class="tool-hub">
    <header class="hub-wrap hub-intro"><div><p class="hub-label">THE AUDIT TOOL DIRECTORY</p><h1>Website audit tools<span>Choose by the job.</span></h1><p class="hub-lede">Find the crawler, page test or search data you need. Compare what each tool checks, understand its limits and explore the guides.</p></div><nav class="hub-shortcuts" aria-label="Popular tool guides"><span class="hub-label">EXPLORE THE CATEGORY</span><a href="/website-audit-tools/best-free/">Free audit tools <span aria-hidden="true">↗</span></a><a href="/website-audit-tools/comparison/">Tool comparisons <span aria-hidden="true">↗</span></a><a href="/website-audit-tools/agencies/">Tools for agencies <span aria-hidden="true">↗</span></a><a href="#tool-guides">All specialist guides <span aria-hidden="true">↓</span></a></nav></header>
    <section class="hub-wrap directory-section" aria-labelledby="directory-title" data-tool-directory>
      <div class="directory-heading"><h2 id="directory-title">Find your audit tool</h2><p>{auditTools.length} tools · grouped by task</p></div>
      <div class="directory-controls" hidden data-enhanced>
        <div class="directory-inputs"><div class="search-field"><label for="tool-search">Search tools</label><input type="search" id="tool-search" placeholder="Name or audit task" autocomplete="off" maxlength="100" /></div><div><label for="tool-task">Audit task</label><select id="tool-task">{tasks.map(task => <option value={task.id}>{task.label}</option>)}</select></div><div><label for="tool-access">Access</label><select id="tool-access"><option value="all">All options</option><option value="free">Free tools</option><option value="free-tier">Free tiers</option><option value="paid">Paid / trial</option></select></div></div>
        <div class="directory-status"><div><p id="tool-count" role="status">Showing all {auditTools.length} tools</p><button type="button" class="hub-reset" id="reset-filters">Reset filters</button></div><div><span id="selection-count" tabindex="-1">0 of 3 selected</span><button type="button" class="compare-trigger" disabled aria-controls="tool-comparison" aria-expanded="false">Compare selected</button><button type="button" id="clear-shortlist" hidden>Clear</button></div></div>
        <p class="selection-help" id="selection-help">Select 2 or 3 tools to compare. Selections stay when you filter.</p><ul class="selected-tools" aria-label="Selected tools" hidden></ul><p class="sr-only" id="selection-announcement" role="status"></p>
      </div>
      <section id="tool-comparison" class="tool-comparison" aria-labelledby="comparison-title" hidden><div class="comparison-heading"><h3 id="comparison-title" tabindex="-1">Your tool comparison</h3><button type="button" id="clear-comparison">Clear selection</button></div><p>Compare scope and limits. These tools may complement each other.</p><p class="scroll-cue" id="comparison-scroll">Scroll horizontally to see all selected tools →</p><div class="comparison-scroll" role="region" aria-label="Selected tool comparison" aria-describedby="comparison-scroll" tabindex="0"><table><caption class="sr-only">Selected website audit tools compared by purpose, access and limitations</caption><thead></thead><tbody></tbody></table></div></section>
      <div class="no-tool-results" hidden><h3>No tools match these filters.</h3><p>Try a broader search or reset the filters to see the full directory.</p><button type="button" data-reset-empty>Show all tools</button></div>
      <div class="tool-records">{auditTools.map(tool => <article id={`tool-${tool.id}`} class="tool-record" data-tool={tool.id} data-tasks={tool.tasks.join(' ')} data-access={tool.access} data-search={`${tool.name} ${tool.fit} ${tool.evidence} ${tool.runs}`.toLowerCase()}>
        <header><p class="record-task">{tool.tasks.map(id => tasks.find(task => task.id === id)?.label).join(' / ')}<span>{tool.runs}</span></p><h3>{tool.guide ? <a href={`/website-audit-tools/${tool.guide}/`}>{tool.name}</a> : tool.name}</h3><p class="record-fit">{tool.fit}</p></header>
        <dl><div><dt>Evidence</dt><dd>{tool.evidence}</dd></div><div><dt>Know the limit</dt><dd>{tool.limitation}</dd></div></dl><div class="record-access">{tool.accessLabel}</div>
        <div class="record-links">{tool.guide && <a class="record-guide" href={`/website-audit-tools/${tool.guide}/`}>Read the {tool.id === 'lighthouse' ? 'Lighthouse' : tool.name.split(' ')[0]} guide <span aria-hidden="true">→</span></a>}<a href={tool.source}>Publisher details <span aria-hidden="true">↗</span><span class="sr-only"> for {tool.name}</span></a></div>
        <footer><small>Source checked <time datetime={tool.checked}>{new Date(tool.checked + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time></small><div class="record-selection"><button type="button" class="view-selection" data-selection-for={tool.id} hidden>View selection ↑</button><label class="compare-choice" hidden data-enhanced><input type="checkbox" value={tool.id} aria-describedby="selection-help" />Compare<span class="sr-only"> {tool.name}</span></label></div></footer>
      </article>)}</div>
      <p class="directory-note">Descriptions are based on publisher documentation. Free tiers have limits; trials expire. Confirm current allowances and terms with the publisher. <a href="#directory-method">How we select tools</a></p>
    </section>
    <section class="hub-wrap guide-section" id="tool-guides" aria-labelledby="guides-title"><div class="directory-heading"><h2 id="guides-title">Explore the tool guides</h2><p>Go deeper on budget, workflow or reporting.</p></div><div class="guide-index">{guides.map(([slug, title, description]) => <a href={`/website-audit-tools/${slug}/`}><div><h3>{title}</h3><p>{description}</p></div><span aria-hidden="true">↗</span></a>)}</div></section>
    <section class="hub-guidance" aria-labelledby="choose-title"><div class="hub-wrap guidance-layout"><div><p class="hub-label">BUILD YOUR AUDIT STACK</p><h2 id="choose-title">Match the tool to the evidence you need.</h2><p>A website audit usually needs more than one kind of evidence. Start with the problem you need to investigate. Add tools only when they answer a different question.</p><a href="/website-audit-checklist/">Use the website audit checklist →</a></div><div class="guidance-steps"><section id="tools-for-specific-needs"><h3>Crawl the site for structural problems</h3><p>A crawler helps find broken links, redirect chains and conflicting indexability signals across URLs. Choose the crawl scope and rendering settings before interpreting the results.</p></section><section><h3>Check a page for speed and access</h3><p>Use Lighthouse or PageSpeed Insights for loading diagnostics. Use WAVE for accessibility annotations. Add keyboard, screen-reader and form checks to the automated results.</p></section><section><h3>Use search data to prioritise</h3><p>Search Console shows queries, impressions and clicks for your property. Combine those observations with crawl findings to decide which pages need investigation first.</p></section></div></div></section>
    <section class="hub-wrap hub-method" id="directory-method" aria-labelledby="method-title"><div><h2 id="method-title">How this directory is put together</h2><p>We include tools that provide distinct evidence for crawling, search visibility, performance or accessibility. Entries describe publisher-documented capabilities and practical scope limits. The order groups tools by their primary task; it is not a quality ranking.</p><p>Publisher sources were checked on the date shown on each entry. This is a documentation-based directory, not a hands-on benchmark. Our suggested use cases are editorial judgments. Prices, allowances and features can change.</p><p>Listings link directly to publishers without affiliate tracking. AuditWeb’s own checker is separate below and is excluded from the comparison directory.</p></div><div class="hub-faq"><h3>Can I audit a website with free tools?</h3><p>Yes. Free tools can cover search data, page diagnostics and smaller crawls. Expect limits on crawl size or features. Start with the <a href="/website-audit-tools/best-free/">free audit tools guide</a> to plan the workflow.</p><h3>Does a good tool score mean my site is fixed?</h3><p>No. A score summarises the checks a tool runs. Verify the affected page, the intended behaviour and the result after each change. Use the <a href="/seo-website-audit/report/">audit report guide</a> to record those decisions.</p></div></section>
    <aside class="hub-wrap owned-tool" aria-labelledby="owned-title"><div><p class="hub-label">OUR OWN FREE TOOL / AUDITWEB</p><h2 id="owned-title">Only need to inspect a page’s HTML?</h2><p>Check titles, canonicals and robots directives from pasted source. The HTML stays in your browser. This checks supplied markup; it does not crawl a live website.</p></div><a href="/free-website-audit/">Open the HTML checker <span aria-hidden="true">↗</span></a></aside>
  </div>
</BaseLayout>
<script>
  import { auditTools } from '../../data/audit-tools';
  const root = document.querySelector<HTMLElement>('[data-tool-directory]');
  if (root) {
    const records = Array.from(root.querySelectorAll<HTMLElement>('.tool-record'));
    const search = root.querySelector<HTMLInputElement>('#tool-search')!;
    const access = root.querySelector<HTMLSelectElement>('#tool-access')!;
    const taskSelect = root.querySelector<HTMLSelectElement>('#tool-task')!;
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('.compare-choice input'));
    const trigger = root.querySelector<HTMLButtonElement>('.compare-trigger')!;
    const panel = root.querySelector<HTMLElement>('#tool-comparison')!;
    const selected = new Set<string>();
    let announcementTimer: ReturnType<typeof setTimeout>;
    const initial = new URLSearchParams(location.search);
    if (Array.from(taskSelect.options).some(option => option.value === initial.get('task'))) taskSelect.value = initial.get('task')!;
    if (Array.from(access.options).some(option => option.value === initial.get('access'))) access.value = initial.get('access')!;
    function filter() {
      const query = search.value.trim().toLowerCase(); const task = taskSelect.value; let count = 0;
      records.forEach(record => {
        const taskMatch = task === 'all' || record.dataset.tasks!.split(' ').includes(task);
        const visible = taskMatch && (access.value === 'all' || record.dataset.access === access.value) && record.dataset.search!.includes(query);
        record.hidden = !visible; if (visible) count++;
      });
      clearTimeout(announcementTimer);
      announcementTimer = setTimeout(() => { root!.querySelector('#tool-count')!.textContent = count === records.length ? `Showing all ${count} tools` : `Showing ${count} of ${records.length} tools`; }, 300);
      const url = new URL(location.href);
      for (const [key, value] of [['task', task], ['access', access.value]]) { if (value === 'all') url.searchParams.delete(key); else url.searchParams.set(key, value); }
      history.replaceState(null, '', url);
      root!.querySelector<HTMLElement>('.no-tool-results')!.hidden = count !== 0;
    }
    function reset() { taskSelect.value = 'all'; search.value = ''; access.value = 'all'; filter(); }
    function cell(tag: string, value: string, scope?: string) { const node = document.createElement(tag); node.textContent = value; if (scope) node.setAttribute('scope', scope); return node; }
    function renderComparison() {
      const tools = Array.from(selected).map(id => auditTools.find(tool => tool.id === id)!);
      const head = document.createElement('tr'); head.append(cell('th', 'Compare by', 'col')); tools.forEach(tool => head.append(cell('th', tool.name, 'col'))); panel.querySelector('thead')!.replaceChildren(head);
      const rows: [string, 'fit' | 'runs' | 'accessLabel' | 'evidence' | 'limitation'][] = [['Useful for', 'fit'], ['Runs in', 'runs'], ['Access', 'accessLabel'], ['Evidence', 'evidence'], ['Know the limit', 'limitation']];
      panel.querySelector('tbody')!.replaceChildren(...rows.map(([title, key]) => { const row = document.createElement('tr'); row.append(cell('th', title, 'row')); tools.forEach(tool => row.append(cell('td', tool[key]))); return row; }));
    }
    function updateSelection() {
      boxes.forEach(box => { box.checked = selected.has(box.value); box.disabled = selected.size === 3 && !box.checked; });
      root!.querySelectorAll<HTMLButtonElement>('[data-selection-for]').forEach(button => button.hidden = !selected.has(button.dataset.selectionFor!));
      root!.querySelector<HTMLButtonElement>('#clear-shortlist')!.hidden = selected.size === 0;
      root!.querySelector('#selection-count')!.textContent = `${selected.size} of 3 selected`;
      root!.querySelector('#selection-help')!.textContent = selected.size === 3 ? '3 tools selected. Uncheck a tool or clear the comparison to choose another.' : 'Select 2 or 3 tools to compare. Selections stay when you filter.';
      const list = root!.querySelector<HTMLUListElement>('.selected-tools')!;
      list.hidden = selected.size === 0;
      list.replaceChildren(...Array.from(selected).map(id => {
        const li = document.createElement('li'); const button = document.createElement('button');
        const name = auditTools.find(tool => tool.id === id)!.name;
        button.type = 'button'; button.textContent = `${name} ×`; button.setAttribute('aria-label', `Remove ${name}`);
        button.addEventListener('click', () => { selected.delete(id); updateSelection(); const next = list.querySelector('button'); if (next) next.focus(); else search.focus(); });
        li.append(button); return li;
      }));
      root!.querySelector('#selection-announcement')!.textContent = `${selected.size} of 3 tools selected.`;
      trigger.disabled = selected.size < 2;
      if (selected.size < 2) { panel.hidden = true; trigger.setAttribute('aria-expanded', 'false'); }
      if (!panel.hidden) renderComparison();
    }
    taskSelect.addEventListener('change', filter);
    search.addEventListener('input', filter); access.addEventListener('change', filter);
    root.querySelector('#reset-filters')!.addEventListener('click', reset);
    root.querySelector('[data-reset-empty]')!.addEventListener('click', () => { reset(); search.focus(); });
    boxes.forEach(box => box.addEventListener('change', () => { if (box.checked && selected.size < 3) selected.add(box.value); else selected.delete(box.value); updateSelection(); }));
    trigger.addEventListener('click', () => { renderComparison(); panel.hidden = false; trigger.setAttribute('aria-expanded', 'true'); root.querySelector<HTMLElement>('#comparison-title')!.focus(); });
    root.querySelector('#clear-comparison')!.addEventListener('click', () => { selected.clear(); updateSelection(); search.focus(); });
    root.querySelector('#clear-shortlist')!.addEventListener('click', () => { selected.clear(); updateSelection(); search.focus(); });
    root.querySelectorAll('[data-selection-for]').forEach(button => button.addEventListener('click', () => { if (selected.size >= 2) trigger.focus(); else root.querySelector<HTMLElement>('#selection-count')!.focus(); }));
    root.querySelectorAll<HTMLElement>('[data-enhanced]').forEach(element => element.hidden = false); filter(); updateSelection();
  }
</script>
