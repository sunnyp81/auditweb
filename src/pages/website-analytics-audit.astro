<ContentLayout
  title="Website Analytics Audit: GA4 Events, Consent and Data Quality"
  description="Audit GA4 measurement definitions, event delivery, consent states and reporting limits. Reconcile differences before using analytics to make decisions."
  breadcrumbs={[
    { label: 'Website Audit', href: '/website-audit/' },
    { label: 'Analytics Audit', href: '/website-analytics-audit/' },
