const toc = [
  { label: 'SSL Labs', id: 'ssl-labs' },
  { label: 'Security Headers', id: 'security-headers' },
  { label: 'Sucuri SiteCheck', id: 'sucuri-sitecheck' },
  { label: 'WPScan', id: 'wpscan' },
