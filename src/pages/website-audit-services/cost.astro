import ContentLayout from '../../layouts/ContentLayout.astro';
const breadcrumbs = [
  { label: 'Website Audit', href: '/website-audit/' },
  { label: 'Services', href: '/website-audit-services/' },
  { label: 'Cost and Pricing', href: '/website-audit-services/cost/' },
];
const toc = [
  { label: 'AuditWeb Prices', id: 'our-pricing' },
  { label: 'What Affects Cost', id: 'what-affects-pricing' },
  { label: 'Free Option', id: 'free-audit-options' },
  { label: 'Compare Quotes', id: 'compare-quotes' },
