---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuditFinding from '../components/AuditFinding.astro';
import '../styles/home.css';
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'AuditWeb', url: 'https://auditweb.site', description: 'Website audits with documented findings, prioritised fixes and verification steps.' };
const scopes = [
  ['Technical SEO', 'Crawl access, indexing signals, response codes and site structure.', '/technical-website-audit/'],
  ['Content & search', 'Page intent, titles, internal links and useful content.', '/seo-website-audit/'],
  ['Experience & access', 'Mobile layouts, navigation, forms and accessibility.', '/website-ux-audit/'],
  ['Performance & security', 'Loading behaviour, HTTPS and the agreed security checks.', '/website-security-audit/'],
];
---
<BaseLayout title="AuditWeb — Website Audits with Evidence & Prioritised Fixes" description="Find what needs fixing on your website. Explore professional audits with documented evidence, a free HTML SEO checker and editable audit templates." schema={schema}>
  <div class="audit-home">
    <section class="home-hero home-wrap" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">WEBSITE AUDITS / EVIDENCE TO ACTION</p>
        <h1 id="home-title">Know what’s wrong.<br /><span>Know what to fix.</span></h1>
        <p class="hero-intro">A website audit should give you a clear next move. Get documented findings, prioritised fixes and a way to check the work.</p>
        <div class="hero-actions"><a class="action-primary" href="/website-audit-services/">Explore professional audits <span aria-hidden="true">↗</span></a><a class="action-secondary" href="/free-website-audit/">Try the free HTML checker <span aria-hidden="true">→</span></a></div>
        <p class="scope-note">Professional review: agreed site scope.<br />Free checker: pasted HTML, checked in your browser.</p>
        <a class="proof-jump" href="#our-self-audit">Start with the evidence <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-evidence"><AuditFinding /></div>
    </section>
    <section id="our-self-audit" class="self-audit-band" aria-labelledby="proof-title">
      <div class="home-wrap proof-layout">
        <div><p class="eyebrow">WE STARTED WITH OUR OWN SITE</p><h2 id="proof-title">Three problems.<br />A documented correction for each.</h2><p>Our self-audit records what failed, what changed and how to reproduce the checks. This is our own work, with no claimed traffic or revenue uplift.</p><a class="text-link" href="/case-studies/auditweb-self-audit/">Read the documented self-audit <span aria-hidden="true">→</span></a></div>
        <ul class="evidence-list">
          <li><span class="finding-id">F–01</span><div><h3>Simulated scanner results</h3><p>Replaced with checks of the HTML you supply.</p></div></li>
          <li><span class="finding-id">F–02</span><div><h3>Promised files were missing</h3><p>Added real PDF and editable template downloads.</p></div></li>
          <li><span class="finding-id">F–03</span><div><h3>Missing URLs returned success</h3><p>Added and verified a proper HTTP 404 response.</p></div></li>
        </ul>
      </div>
    </section>
    <section class="home-wrap home-section" aria-labelledby="scope-title">
      <div class="section-heading"><div><p class="eyebrow">PROFESSIONAL REVIEW</p><h2 id="scope-title">The finding is just the start.</h2></div><p>Agree the scope. Review the evidence. Leave with an implementation order and an observable check for each fix.</p></div>
      <div class="scope-layout"><div class="scope-list">{scopes.map(([title, description, href]) => <a href={href}><div><h3>{title}</h3><p>{description}</p></div><span aria-hidden="true">↗</span></a>)}</div><aside class="deliverable-note" aria-label="Audit deliverables"><p class="eyebrow">YOUR ACTION PLAN</p><h3>Built for the person<br />doing the fixing.</h3><ul><li>Specific affected pages</li><li>Evidence and reproduction steps</li><li>Priorities and dependencies</li><li>Recommended changes</li><li>Verification criteria</li></ul><a class="text-link" href="/website-audit-checklist/">Explore the audit checklist →</a></aside></div>
      <div class="service-options"><div><h3>Basic audit <span>$297</span></h3><p>Essential checks and a prioritised report for smaller sites.</p></div><div><h3>Comprehensive audit <span>$997</span></h3><p>Broader technical, content and experience review.</p></div><a class="action-secondary" href="/website-audit-services/">Compare scope & next steps →</a></div>
      <p class="small-note">Prices shown in USD. Confirm scope, deliverables and terms before commissioning work. Larger or complex sites require a custom scope.</p>
    </section>
    <section class="resource-band" aria-labelledby="resources-title"><div class="home-wrap home-section">
      <div class="section-heading"><div><p class="eyebrow">START WITH SOMETHING USEFUL</p><h2 id="resources-title">Tools for your next audit.</h2></div><p>Inspect a page, organise the findings or work through the method. All three resources are open to use.</p></div>
      <div class="resource-features">
        <div><div class="source-sample" aria-label="Example HTML checked by the free tool"><span>HTML / EXAMPLE INPUT</span><code>&lt;meta name="robots"<br />&nbsp; content="noindex"&gt;</code><p>Review: noindex directive present</p></div><h3>Check what your HTML says.</h3><p>Inspect titles, canonical tags, robots directives and other on-page signals. Pasted source stays in your browser.</p><a class="text-link" href="/free-website-audit/">Open the free HTML checker →</a></div>
        <div><div class="template-sample" aria-label="Fields in the actual audit report template"><span>EDITABLE REPORT / .MD</span><strong>F-01: [specific observed issue]</strong><div><span>Evidence</span><span>[response or source excerpt]</span></div><div><span>Change</span><span>[specific action]</span></div><div><span>Verification</span><span>[expected observable result]</span></div></div><h3>Turn findings into a handoff.</h3><p>Four editable Markdown templates and a printable 50-check PDF. No email or account required.</p><a class="text-link" href="/resources/agency-audit-toolkit/">Preview & download the toolkit →</a></div>
      </div>
      <a class="guide-route" href="/website-audit/"><div><span class="eyebrow">THE COMPLETE GUIDE</span><h3>Learn how to audit a website.</h3><p>What to check, how to record evidence and where to start.</p></div><span aria-hidden="true">↗</span></a>
    </div></section>
    <section class="home-wrap final-route"><div><p class="eyebrow">A CLEAR NEXT STEP</p><h2>Get an audit you can act on.</h2><p>Start with your website, your business question and the scope you need reviewed.</p></div><a class="action-primary" href="/website-audit-services/">Explore professional audits ↗</a></section>
  </div>
</BaseLayout>
