---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Check Your Inbox | AuditWeb"
  description="One step left: confirm your email address to start getting AuditWeb's weekly website tips."
  noindex={true}
>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="glass rounded-2xl p-10">
      <div class="text-5xl mb-6">✓</div>
      <h1 class="text-3xl font-extrabold mb-4">Check your inbox</h1>
      <p class="text-text-muted mb-6">
        We've sent a confirmation email. Open it and press the confirm link to start your weekly tips. If it isn't there in a few minutes, check your spam folder.
      </p>
      <h2 class="text-xl font-bold mb-4">Explore audit resources</h2>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/website-audit/" class="px-6 py-3 bg-primary hover:bg-primary-dark text-surface font-semibold rounded-lg transition-colors">
          Read Our Audit Guide
        </a>
        <a href="/free-website-audit/" class="px-6 py-3 border border-border hover:border-primary/50 text-text font-semibold rounded-lg transition-colors">
          Try the HTML Checker
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
