<ContentLayout
  title="Website Usability Audit: Task Completion and Error Recovery"
  description="Run a usability audit with realistic tasks, representative participants, navigation checks and reproducible findings. Separate observation from interpretation."
  breadcrumbs={[
    { label: 'Website Audit', href: '/website-audit/' },
    { label: 'Usability Audit', href: '/website-usability-audit/' },
