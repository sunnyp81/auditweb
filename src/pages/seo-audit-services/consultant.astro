  { label: 'SEO Audit Consultant', href: '/seo-audit-services/consultant/' },
];

const toc = [
  { label: 'What an SEO Audit Consultant Does', id: 'what-an-seo-audit-consultant-does' },
  { label: 'When to Hire One', id: 'when-to-hire-one' },
  { label: 'Consultant vs Agency vs Software', id: 'consultant-vs-agency-vs-software' },
