---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="This AuditWeb page could not be found. Browse the audit resources or return home." noindex={true}>
  <section class="max-w-3xl mx-auto px-6 py-20">
    <h1 class="text-4xl font-bold mb-6">Page not found</h1>
    <p class="text-text-muted mb-6">This address does not match a page on AuditWeb.</p>
    <h2 class="text-2xl font-bold mb-4">Find a useful resource</h2>
    <p><a class="text-primary underline" href="/">Return to the homepage</a> or <a class="text-primary underline" href="/resources/agency-audit-toolkit/">browse the agency audit toolkit</a>.</p>
  </section>
</BaseLayout>
